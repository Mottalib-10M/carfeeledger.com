---
/**
 * A calculator or guide page of `src/content/pages/`: H1, the calculator first, the folded answer, the
 * 51-row table when the page has one, then the body. On the hub page, the list of the state pages.
 * FAQ (shown and marked up from one list), related pages, sources and publisher: PageLayout.
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { route, ROUTES } from '../i18n/routes';
import { label, GROUPS } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById, statePageById, STATE_PAGES, stateId, STATE_HUB } from '../lib/pages';
import { helpers, SOURCES, table } from '../lib/helpers';
import { comparison } from '../lib/tables';
import { STATE_LIST, P } from '../lib/data';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/page-types';
interface Props { page: PageDef }
const { page } = Astro.props;
const lang = 'en';
const ui = t(lang);
const path = route(page.id, lang);
const group = GROUPS.find((g) => g.id === page.group)!;
const parts = page.body(helpers()).split(/<!--mini:([A-Za-z0-9_-]+)(?:\|([A-Za-z0-9+/=]+))?-->/);
const decode = (b?: string) => (b ? Buffer.from(b, 'base64').toString('utf8') : undefined);
const jsonLd = [webApplicationSchema({ name: page.h1, description: page.description, path, lang }), articleSchema({ title: page.h1, description: page.description, path, lang }), webPageSchema({ name: page.h1, description: page.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: page.nav, path }])];
if (page.faqs.length) jsonLd.push(faqSchema(page.faqs, lang));
const nameOf = (slug: string) => STATE_LIST.find((s) => s.slug === slug)?.name ?? slug;
const card = (id: string) => pageById(id)?.card ?? (statePageById(id) ? `Every fee line for ${nameOf(statePageById(id)!.slug)}, with its source` : '');
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id), description: card(id) }));
const sources = page.sources.filter((k) => SOURCES[k]).map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url }));
const cmp = page.table ? comparison(page.table) : null;
const isHub = page.id === STATE_HUB;
---
<PageLayout title={page.title} description={page.description} lang={lang} jsonLd={jsonLd} faqs={page.faqs} related={related} sources={sources} breadcrumbs={[{ label: group.label }, { label: page.nav }]} anneeEnHaut={!/20\d\d/.test(page.h1 + page.intro)}>
  <article>
    <header class="mb-5">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">{group.label} · 50 states and DC</p>
      <h1 class="mt-1 font-serif text-3xl font-bold text-navy-900 md:text-4xl">{page.h1}</h1>
      <p class="mt-3 text-lg text-navy-700">{page.intro}</p>
      <p class="mt-3 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline hover:text-navy-900">{label('method')}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a></p>
    </header>
    <div data-outil data-chrome class="mb-8"><Tool kind={page.tool} state={page.state} idPrefix={page.id.slice(0, 6)} /></div>
    <Clamp text={page.resume} lang={lang} id={`clamp-${page.id}`} class="mb-8" />
    {isHub && (
      <section data-chrome class="mb-10">
        <h2 class="font-serif text-2xl font-bold text-navy-900">Car fees in each state</h2>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-1.5 text-sm sm:grid-cols-3 lg:grid-cols-4">
          {STATE_PAGES.map((s) => <li><a class="text-accent-700 underline-offset-2 hover:underline" href={route(stateId(s.slug), lang)}>{nameOf(s.slug)}</a></li>)}
        </ul>
      </section>
    )}
    <div class="prose prose-slate max-w-none prose-headings:font-serif">
      {parts.map((p, i) => i % 3 === 0 ? <Fragment set:html={p ?? ''} /> : i % 3 === 1 ? <MiniSim client:load kind={p} arg={decode(parts[i + 1])} href={path} /> : null)}
    </div>
    {cmp && (
      <section data-chrome class="mt-10">
        <h2 class="font-serif text-2xl font-bold text-navy-900">The 51 jurisdictions side by side</h2>
        <Fragment set:html={table(cmp.headers, cmp.rows, `Reference vehicle: ${P.reference.label}. Calculated with each state's engine and data file; state names open the detailed page.`, cmp.align)} />
      </section>
    )}
  </article>
</PageLayout>
