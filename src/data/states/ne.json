   "accessed": "2026-10-11",
   "quote": "$34,000 to $35,999 $580.00 ... First Year 100% Second Year 90% ... Fourteenth Year and Older 0% ... MSRP=$20,000 to $39,999 20.00$ 14.00$ 7.00$"
  },
  "mv-2025": {
   "name": "Nebraska DMV, 2025 Motor Vehicle Taxes",
