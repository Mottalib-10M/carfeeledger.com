  "cdtfa-dealers": {
   "name": "CDTFA, Tax Guide for Motor Vehicle Dealers, Industry Topics (trade-ins, documentation fees)",
   "url": "https://cdtfa.ca.gov/industry/motor-vehicle-dealers/industry-topics.htm",
   "accessed": "2026-10-11",
   "quote": "If you accept a trade-in on the sale of a vehicle, you must still report the total selling price ... You cannot deduct the allowance for the trade-in. ... taxable sales include ... documentation fees (doc fees)"
  },
  "bar-faq": {
   "name": "California Bureau of Automotive Repair, Smog Check FAQ",
   "url": "https://www.bar.ca.gov/consumer/smog-check-program/faq/",
   "accessed": "2026-10-11",
   "quote": "Eight model years and newer - do not need a Smog Check for vehicle registration renewal. Instead, California law requires a smog abatement fee ... Inspection prices are not regulated by BAR. ... The station must charge a $8.25 Smog Check certificate fee."
  },
  "hsc-44060": {
   "name": "California Health and Safety Code section 44060(d)(1), smog abatement fee",
   "url": "https://california.public.law/codes/health_and_safety_code_section_44060",
   "accessed": "2026-10-11",
   "quote": "Motor vehicles exempted ... that are seven or eight model-years old shall be subject to an annual smog abatement fee of twenty-five dollars ($25)."
  },
