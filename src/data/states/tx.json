 "defaultCounty": "harris-county",
 "singular": [
  "Texas taxes a car at a flat 6.25% statewide, with no city or county add-on, and deducts the trade-in from the taxable price [cpa-tax].",
  "On a private-party used sale, tax is due on the price or on the vehicle's standard presumptive value, whichever is higher, unless a certified appraisal shows a lower value [spv].",
  "The dealer documentary fee is not part of the taxable price in Texas, and fees of $225 or less are presumed reasonable [cpa-consideration].",
  "Since January 1, 2025, ordinary cars no longer need a safety inspection; owners pay a $7.50 inspection program replacement fee with registration instead [txdmv-reg].",
  "Seventeen counties still require an emissions test, with a $2.75 state portion collected at registration [txdmv-reg].",
  "A new car bought from a Texas dealer gets 24 months of registration, with a $16.75 inspection replacement fee covering both years [regman].",
  "Fully electric cars pay $200 a year, or $400 when a new EV receives its first two-year registration; hybrids pay nothing extra [txdmv-reg].",
  "County road and bridge, transportation and child safety fees add $0 to $31.50 a year depending on the county [fee-chart].",
  "The title fee is $33 in emissions counties and $28 elsewhere [title-fee]."
 ],
 "sources": {
  "txdmv-reg": {
   "name": "TxDMV, Register Your Vehicle (fees)",
   "url": "https://www.txdmv.gov/motorists/register-your-vehicle",
   "accessed": "2026-10-11",
   "quote": "The standard fee for cars and lighter pickup trucks is a base registration fee of $50.75 ... Inspection Replacement Fee $7.50 ... Emissions Inspection Fee $2.75 ... Inspection Replacement Fee (new two-year vehicles) $16.75 ... new electric vehicles issued two years of registration ... will be assessed a $400 fee."
  },
  "fee-chart": {
   "name": "TxDMV Fee Chart 1C, Texas Registration Fees effective January 1, 2026 (local fees by county)",
   "url": "https://www.txdmv.gov/sites/default/files/body-files/FeeChart_1C.pdf",
   "accessed": "2026-10-11",
   "quote": "EFFECTIVE January 1, 2026 EXPIRES December 31, 2026 ... Bexar $21.50 ... Borden $0"
  },
  "regman": {
   "name": "TxDMV Motor Vehicle Registration Manual (April 2026), 22.9 24 Months of Registration and P&H fee",
   "url": "https://content.govdelivery.com/attachments/TXDMV/2026/05/06/file_attachments/3641955/Reg%20Manual%20April%202026.pdf",
   "accessed": "2026-10-11",
   "quote": "Passenger cars and light trucks sold on a MCO by a Texas dealer must receive 24 months of initial registration ... A $4.75 P&H Fee will be assessed on certain registration transactions."
  },
  "cpa-tax": {
   "name": "Texas Comptroller, Motor Vehicle Sales and Use Tax",
   "url": "https://comptroller.texas.gov/taxes/motor-vehicle/sales-use.php",
   "accessed": "2026-10-11",
   "quote": "Sales: 6.25 percent of sales price, minus any trade-in allowance. The taxable value of private-party purchases of used motor vehicles may be based on the standard presumptive value."
  },
  "cpa-consideration": {
   "name": "Texas Comptroller, Publication 96-254, Total Consideration",
   "url": "https://comptroller.texas.gov/taxes/publications/96-254/total-consideration.php",
   "accessed": "2026-10-11",
   "quote": "The following items are not part of total consideration ... separately stated charge for preparing and processing documents related to the transfer of a motor vehicle, usually called a documentary fee"
  },
  "title-fee": {
   "name": "Tarrant County Tax Assessor-Collector, Title Fees",
   "url": "https://www.tarrantcountytx.gov/en/tax/motor-vehicle/FAQs-Motor-Vehicle-Titles/title-fees.html",
   "accessed": "2026-10-11",
   "quote": "Title fees in Texas are based on the county you live in and can be $28 or $33, depending on whether you reside in an emissions compliant county."
  },
  "occc-inspection": {
   "name": "OCCC Bulletin B25-1, Inspection Program Replacement Fee and Emissions Fee",
   "url": "https://occc.texas.gov/wp-content/uploads/2025/11/b25-1-mvsf-inspection-replacement-emissions-fee.pdf",
   "accessed": "2026-10-11",
   "quote": "The motor vehicle inspection program replacement fee is a $7.50 fee paid to the state ... a dealer pays $18.50 to an inspection station and $2.75 to the state for the emissions inspection"
  },
  "doc-fee": {
   "name": "7 Texas Administrative Code 84.205, Documentary Fee",
   "url": "https://www.law.cornell.edu/regulations/texas/7-Tex-Admin-Code-SS-84-205",
   "accessed": "2026-10-11",
   "quote": "A seller is not required to provide a notification or cost analysis to the OCCC before charging a documentary fee of $225 or less."
  },
  "spv": {
   "name": "TxDMV, Standard Presumptive Values",
   "url": "https://www.txdmv.gov/standard-presumptive-calculator",
   "accessed": "2026-10-11",
   "quote": "Texans who buy a used vehicle from anyone other than a licensed vehicle dealer are required to pay motor vehicle sales tax of 6.25 percent on the purchase price or standard presumptive value (SPV), whichever is the highest value."
  }
